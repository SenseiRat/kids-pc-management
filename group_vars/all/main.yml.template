---
# User variables
child_username: ""

parent_username: ""
parent_public_key: ""

ansible_username: "ansible"
ansible_public_key: ""

# Per-app screentime limits (minutes). Each app is tracked and enforced
# independently - time only accrues against an app while its window is
# focused and the user is actively providing input.
# Sample values for reference:
#   30 minutes = 30
#   1 hour     = 60
#   4 hours    = 240
#   6 hours    = 360
#   8 hours    = 480
#   12 hours   = 720
#   24 hours (disabled) = 1440
screentime_apps:
  - app: "com.valvesoftware.Steam"
    daily_limit_minutes: 120

screentime_poll_interval_seconds: 30
screentime_warning_minutes: 5
screentime_final_warning_minutes: 1

idle_watcher_threshold: 60
idle_watcher_controller_deadzone_percent: 10
reboot_idle_threshold_minutes: 15
